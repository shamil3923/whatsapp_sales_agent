# WhatsApp Sales Agent Pro - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# GOOGLE AI CONFIGURATION
# =============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# WHATSAPP BUSINESS API CONFIGURATION
# =============================================================================
# Get these from Meta Developer Console: https://developers.facebook.com/

# Temporary Access Token (expires in 24 hours for testing)
# For production, use permanent access token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# Phone Number ID from WhatsApp Business API setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Webhook Verification Token (you choose this)
WHATSAPP_VERIFY_TOKEN=sales_agent_verify_token

# App Secret from the Meta app dashboard (Settings > Basic > App Secret).
# Used to verify the X-Hub-Signature-256 HMAC on every incoming webhook POST.
# REQUIRED IN ANY DEPLOYMENT: while this is unset, signature verification is
# disabled and anyone who learns your webhook URL can post fabricated messages
# and spend your model budget.
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Environment: development, staging, production
FLASK_ENV=development

# Debug mode (True for development, False for production)
DEBUG=True

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application port (default: 5000)
PORT=5000

# =============================================================================
# STORAGE
# =============================================================================
# SQLite database holding the `users` and `messages` tables.
AGENT_DB_PATH=data/agent.db

# =============================================================================
# TELEMETRY
# =============================================================================
# One JSON line is appended per conversation turn.
TELEMETRY_LOG_PATH=data/telemetry/turns.jsonl

# Set to 0 to stop writing telemetry lines (they are still logged).
TELEMETRY_ENABLED=1

# Salt for the phone-number hash written to telemetry. Raw numbers are never
# logged; change this per deployment so logs cannot be correlated.
TELEMETRY_PHONE_SALT=change_me_per_deployment

# List prices used to ESTIMATE per-turn cost from reported token counts, in USD
# per 1M tokens. Defaults match Google's published gemini-2.0-flash text pricing
# as of 2026-09-17. These are estimates, not billed amounts.
MODEL_PRICE_IN_PER_MTOK=0.10
MODEL_PRICE_OUT_PER_MTOK=0.40

# =============================================================================
# OPTIONAL: EXTERNAL DATABASE
# =============================================================================
# Not used by the current code, which stores everything in SQLite above.

# PostgreSQL
# DATABASE_URL=postgresql://username:password@localhost:5432/whatsapp_bot

# =============================================================================
# OPTIONAL: REDIS CONFIGURATION
# =============================================================================
# Uncomment if using Redis for caching/session storage
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# OPTIONAL: MONITORING & ANALYTICS
# =============================================================================
# Sentry for error tracking
# SENTRY_DSN=your_sentry_dsn_here

# Google Analytics
# GA_TRACKING_ID=your_ga_tracking_id_here

# =============================================================================
# OPTIONAL: EXTERNAL SERVICES
# =============================================================================
# Custom currency API (if not using exchangerate-api.com)
# CURRENCY_API_KEY=your_currency_api_key_here
# CURRENCY_API_URL=https://api.currencyapi.com/v3/latest

# Email service (for notifications)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Secret key for session management (generate a random string)
SECRET_KEY=your_secret_key_here

# Webhook signature verification (for production)
# WEBHOOK_SECRET=your_webhook_secret_here

# Rate limiting (requests per minute)
RATE_LIMIT=60

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_CURRENCY_CONVERSION=True
ENABLE_WEB_SEARCH=True
ENABLE_ANALYTICS=False
ENABLE_USER_SESSIONS=False

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Ngrok settings for local development
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here
# NGROK_SUBDOMAIN=your_custom_subdomain

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Domain name for production
# DOMAIN_NAME=yourdomain.com

# SSL certificate paths
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# AWS S3 for backups (optional)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=your_backup_bucket

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit the actual .env file to version control
# 2. Use strong, unique values for SECRET_KEY and tokens
# 3. For production, use permanent access tokens from Meta
# 4. Consider using environment-specific .env files (.env.dev, .env.prod)
# 5. Regularly rotate API keys and access tokens
# 6. Use a password manager to generate and store secure values
